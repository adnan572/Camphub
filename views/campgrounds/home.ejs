<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>YelpCamp</title>
    <link rel="stylesheet" crossorigin="anonymous" href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="stylesheets/home.css">
</head>
<body class="d-flex text-center text-white bg-dark">

    <div class="cover-container d-flex w-100 h-100 mx-auto flex-column">
        <header class="mb-auto head">
            <div class="row">
                <div class="col-md-6 text-start">
                    <h3>YelpCamp</h3>
                </div>
                <div class="col-md-6 text-end">
                    <nav class="nav nav-masthead justify-content-end">
                        <a class="nav-link active" href="#">Home</a>
                        <% if(!currentUser) { %>
                        <a href="/login" class="nav-link">Login</a>
                       <a href="/register" class="nav-link">Register</a>
                       <% } else { %>
                       <a href="/logout" class="nav-link">Logout</a>
                    
                            <% } %>
                    </nav>
                </div>
            </div>
        </header>
        <main class="px-3 my-auto">
            <h1>YelpCamp</h1>
            <p class="lead">Welcome to YelpCamp <br> jump right in and explore our many campgrounds <br>
                feel free to share some of your own and comment on others.</p>
            <a href="/campgrounds" class="btn btn-lg btn-secondary font-weight-bold border-white bg-white">View Campgrounds</a>
        </main>
        <footer class="mt-auto text-white-50">
            <p>&copy; 2024 YelpCamp</p>
        </footer>
    </div>

    <script crossorigin="anonymous" src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
