<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CampHub</title>
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5.3 -->
    <link rel="stylesheet" crossorigin="anonymous" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/stylesheets/home.css">
</head>
<body>

    <div class="home-container">
        <!-- Minimal Header Navigation -->
        <header class="home-nav-wrapper">
            <div class="d-flex justify-content-between align-items-center">
                <a href="/" class="home-brand">CampHub</a>
                <nav class="d-flex align-items-center gap-1">
                    <a class="home-nav-link active" href="/">Home</a>
                    <a class="home-nav-link" href="/campgrounds">Campgrounds</a>
                    <% if(!currentUser) { %>
                        <a href="/login" class="home-nav-link">Login</a>
                        <a href="/register" class="home-nav-link home-nav-btn">Sign Up</a>
                    <% } else { %>
                        <a href="/campgrounds/new" class="home-nav-link d-none d-sm-inline">New Spot</a>
                        <a href="/logout" class="home-nav-link home-nav-btn">Logout (<%= currentUser.username %>)</a>
                    <% } %>
                </nav>
            </div>
        </header>

        <!-- Minimalist Hero Section -->
        <main class="hero-content text-center">
            <h1 class="hero-title">CampHub</h1>
            <p class="hero-subtitle">
                Jump right in and explore campgrounds from all over the world, or share your own favorite spots.
            </p>
            <div class="hero-cta-group">
                <a href="/campgrounds" class="btn-hero-primary">View Campgrounds</a>
            </div>
        </main>

        <!-- Minimal Footer -->
        <footer class="home-footer text-center">
            <p class="mb-0 text-white-50">&copy; <%= new Date().getFullYear() %> CampHub</p>
        </footer>
    </div>

    <script crossorigin="anonymous" src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
