<% layout('layouts/boilerplate') %>
<link rel="stylesheet" href="/stylesheets/star.css">

<div class="row g-4">
   <!-- Left Column: Carousel & Details -->
   <div class="col-lg-7">
      <div class="show-card mb-4">
         <% if (campground.images && campground.images.length) { %>
            <div id="campgroundCarousel" class="carousel slide show-carousel mb-0" data-bs-ride="carousel">
               <div class="carousel-inner">
                  <% campground.images.forEach((img, i) => { %>
                     <div class="carousel-item <%= i === 0 ? 'active' : '' %>">
                        <img src="<%= img.url %>" class="d-block w-100" alt="<%= campground.title %>">
                     </div>
                  <% }) %>
               </div>
               <% if (campground.images.length > 1) { %>
                  <button class="carousel-control-prev" type="button" data-bs-target="#campgroundCarousel" data-bs-slide="prev">
                     <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                     <span class="visually-hidden">Previous</span>
                  </button>
                  <button class="carousel-control-next" type="button" data-bs-target="#campgroundCarousel" data-bs-slide="next">
                     <span class="carousel-control-next-icon" aria-hidden="true"></span>
                     <span class="visually-hidden">Next</span>
                  </button>
               <% } %>
            </div>
         <% } else { %>
            <div class="show-carousel mb-0">
               <img src="https://res.cloudinary.com/dpmoflxc3/image/upload/v1722797295/YelpCamp/cvyvqyawlh1copeqrchw.jpg" class="d-block w-100" alt="Placeholder">
            </div>
         <% } %>

         <div class="card-body p-4">
            <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-2">
               <h1 class="h2 fw-bold text-dark mb-0"><%= campground.title %></h1>
               <% if(campground.price) { %>
                  <span class="badge bg-success-subtle text-success-emphasis fs-5 px-3 py-2 rounded-pill">
                     $<%= campground.price %><small class="fs-6 text-muted">/night</small>
                  </span>
               <% } %>
            </div>

            <div class="text-secondary d-flex align-items-center mb-3">
               <i class="bi bi-geo-alt-fill text-danger me-2"></i>
               <span><%= campground.location %></span>
            </div>

            <p class="card-text text-secondary mb-4" style="line-height: 1.7;"><%= campground.description %></p>
         </div>

         <ul class="list-group list-group-flush border-top">
            <li class="list-group-item d-flex align-items-center justify-content-between py-3 px-4">
               <span class="text-muted"><i class="bi bi-person-circle text-success me-2"></i>Submitted by</span>
               <span class="fw-semibold text-dark"><%= campground.author.username %></span>
            </li>
            <li class="list-group-item d-flex align-items-center justify-content-between py-3 px-4">
               <span class="text-muted"><i class="bi bi-tag text-primary me-2"></i>Pricing</span>
               <span class="fw-semibold text-dark">$<%= campground.price %> per night</span>
            </li>
         </ul>

         <% if(currentUser && campground.author.equals(currentUser._id)) { %>
            <div class="card-body p-4 bg-light border-top d-flex gap-2">
               <a href="/campgrounds/<%= campground._id %>/edit" class="btn btn-warning d-inline-flex align-items-center">
                  <i class="bi bi-pencil-square me-1"></i>Edit
               </a>
               <form class="d-inline" action="/campgrounds/<%= campground._id %>?_method=DELETE" method="post">
                  <button class="btn btn-danger d-inline-flex align-items-center">
                     <i class="bi bi-trash3 me-1"></i>Delete
                  </button>
               </form>
            </div>
         <% } %>

         <div class="card-footer bg-white text-muted px-4 py-3 d-flex justify-content-between align-items-center">
            <small><i class="bi bi-clock-history me-1"></i>Active listing</small>
            <a href="/campgrounds" class="text-decoration-none small text-success fw-semibold">
               <i class="bi bi-arrow-left me-1"></i>Back to Campgrounds
            </a>
         </div>
      </div>
   </div>

   <!-- Right Column: Map & Reviews -->
   <div class="col-lg-5">
      <!-- Map Widget Card -->
      <div class="card show-card mb-4">
         <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
            <span class="fw-bold text-dark"><i class="bi bi-pin-map-fill text-danger me-2"></i>Location Map</span>
            <span class="badge bg-light text-secondary border">Coordinates verified</span>
         </div>
         <div class="card-body p-2">
            <div id="map" style="width: 100%; height: 260px; border-radius: 10px;"></div>
         </div>
      </div>

      <!-- Leave a Review Form -->
      <% if(currentUser) { %>
         <div class="card show-card mb-4 p-4">
            <h4 class="h5 fw-bold text-dark mb-3 d-flex align-items-center">
               <i class="bi bi-star-half text-warning me-2"></i>Leave a Review
            </h4>
            <form action="/campgrounds/<%= campground._id %>/reviews" class="validated-form" method="post" novalidate>
               <div class="mb-3">
                  <label class="form-label d-block text-secondary small fw-bold text-uppercase mb-1">Your Rating</label>
                  <fieldset class="starability-basic">
                     <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                     <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                     <label for="first-rate1" title="Terrible">1 star</label>
                     <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                     <label for="first-rate2" title="Not good">2 stars</label>
                     <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                     <label for="first-rate3" title="Average">3 stars</label>
                     <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                     <label for="first-rate4" title="Very good">4 stars</label>
                     <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                     <label for="first-rate5" title="Amazing">5 stars</label>
                  </fieldset>
               </div>
               <div class="mb-3">
                  <label for="body" class="form-label text-secondary small fw-bold text-uppercase">Your Review</label>
                  <textarea class="form-control" name="review[body]" id="body" rows="3" placeholder="Share your experience at this campground..." required></textarea>
                  <div class="valid-feedback">Looks great!</div>
               </div>
               <button class="btn btn-camp-primary d-inline-flex align-items-center">
                  <i class="bi bi-send me-2"></i>Submit Review
               </button>
            </form>
         </div>
      <% } else { %>
         <div class="card show-card mb-4 p-4 text-center bg-white">
            <div class="mb-2"><i class="bi bi-chat-square-quote fs-2 text-success opacity-75"></i></div>
            <h5 class="fw-bold mb-1">Visited <%= campground.title %>?</h5>
            <p class="text-secondary small mb-3">Log in to leave a review and help fellow campers find the best spots.</p>
            <div>
               <a href="/login" class="btn btn-sm btn-camp-primary">
                  <i class="bi bi-box-arrow-in-right me-1"></i>Log in to Review
               </a>
            </div>
         </div>
      <% } %>

      <!-- Reviews Section -->
      <div class="d-flex align-items-center justify-content-between mb-3">
         <h4 class="h5 fw-bold text-dark mb-0">
            <i class="bi bi-chat-left-text text-success me-2"></i>Camper Reviews
         </h4>
         <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill">
            <%= campground.reviews.length %> reviews
         </span>
      </div>

      <% if(!campground.reviews.length) { %>
         <div class="card show-card p-4 text-center text-muted">
            <i class="bi bi-chat-dots fs-1 d-block mb-2 text-secondary opacity-50"></i>
            <p class="mb-0">No reviews yet. Be the first to share your experience!</p>
         </div>
      <% } %>

      <% for(let review of campground.reviews) { %>
         <div class="card review-card mb-3">
            <div class="card-body p-3">
               <div class="d-flex align-items-center justify-content-between mb-2">
                  <div class="d-flex align-items-center gap-2">
                     <div class="avatar-circle">
                        <%= review.author.username.charAt(0).toUpperCase() %>
                     </div>
                     <div>
                        <h6 class="fw-bold mb-0 text-dark"><%= review.author.username %></h6>
                        <small class="text-muted">Verified Camper</small>
                     </div>
                  </div>
                  <% if(currentUser && review.author.equals(currentUser._id)) { %>
                     <form action="/campgrounds/<%= campground._id %>/reviews/<%= review._id %>?_method=DELETE" method="post" class="mb-0">
                        <button class="btn btn-sm btn-outline-danger border-0" title="Delete Review">
                           <i class="bi bi-trash3"></i>
                        </button>
                     </form>
                  <% } %>
               </div>

               <p class="starability-result mb-2" data-rating="<%= review.rating %>">
                  Rated: <%= review.rating %> stars
               </p>
               <p class="card-text text-secondary mb-0"><%= review.body %></p>
            </div>
         </div>
      <% } %>
   </div>
</div>

<script>
   const campground = <%- JSON.stringify(campground) %>;
</script>
<script src="/javascripts/map.js"></script>
