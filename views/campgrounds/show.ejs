<% layout('layouts/boilerplate') %>
<link rel="stylesheet" href="/stylesheets/star.css">

<div class="row g-4">
   <!-- Left Column: Carousel & Details -->
   <div class="col-lg-7">
      <div class="show-card mb-4">
         <% if (campground.images && campground.images.length) { %>
            <div id="campgroundCarousel" class="carousel slide show-carousel mb-0" data-bs-ride="carousel">
               <div class="carousel-inner">
                  <% campground.images.forEach((img, i) => { %>
                     <div class="carousel-item <%= i === 0 ? 'active' : '' %>">
                        <img src="<%= img.url %>" class="d-block w-100" alt="<%= campground.title %>">
                     </div>
                  <% }) %>
               </div>
               <% if (campground.images.length > 1) { %>
                  <button class="carousel-control-prev" type="button" data-bs-target="#campgroundCarousel" data-bs-slide="prev">
                     <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                     <span class="visually-hidden">Previous</span>
                  </button>
                  <button class="carousel-control-next" type="button" data-bs-target="#campgroundCarousel" data-bs-slide="next">
                     <span class="carousel-control-next-icon" aria-hidden="true"></span>
                     <span class="visually-hidden">Next</span>
                  </button>
               <% } %>
            </div>
         <% } else { %>
            <div class="show-carousel mb-0">
               <img src="https://res.cloudinary.com/dpmoflxc3/image/upload/v1722797295/YelpCamp/cvyvqyawlh1copeqrchw.jpg" class="d-block w-100" alt="Placeholder">
            </div>
         <% } %>

         <div class="card-body p-4">
            <div class="d-flex align-items-baseline justify-content-between flex-wrap gap-2 mb-2">
               <h1 class="h2 fw-bold text-dark mb-0"><%= campground.title %></h1>
               <span class="fs-5 fw-bold text-dark">$<%= campground.price %><small class="text-muted fw-normal fs-6">/night</small></span>
            </div>

            <p class="text-muted mb-3"><%= campground.location %></p>
            <p class="card-text text-secondary mb-4" style="line-height: 1.65;"><%= campground.description %></p>
         </div>

         <ul class="list-group list-group-flush border-top">
            <li class="list-group-item text-secondary py-3 px-4">
               Submitted by <span class="fw-semibold text-dark"><%= campground.author.username %></span>
            </li>
         </ul>

         <% if(currentUser && campground.author.equals(currentUser._id)) { %>
            <div class="card-body p-4 bg-light border-top d-flex gap-2">
               <a href="/campgrounds/<%= campground._id %>/edit" class="btn btn-warning">Edit</a>
               <form class="d-inline" action="/campgrounds/<%= campground._id %>?_method=DELETE" method="post">
                  <button class="btn btn-danger">Delete</button>
               </form>
            </div>
         <% } %>

         <div class="card-footer bg-white text-muted px-4 py-3">
            <a href="/campgrounds" class="text-decoration-none small text-dark fw-medium">
               &larr; Back to Campgrounds
            </a>
         </div>
      </div>
   </div>

   <!-- Right Column: Map & Reviews -->
   <div class="col-lg-5">
      <!-- Map -->
      <div id="map" style="width: 100%; height: 260px;" class="mb-4"></div>

      <!-- Leave a Review Form -->
      <% if(currentUser) { %>
         <div class="card show-card mb-4 p-4">
            <h5 class="fw-bold text-dark mb-3">Leave a Review</h5>
            <form action="/campgrounds/<%= campground._id %>/reviews" class="validated-form" method="post" novalidate>
               <div class="mb-3">
                  <fieldset class="starability-basic">
                     <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                     <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                     <label for="first-rate1" title="Terrible">1 star</label>
                     <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                     <label for="first-rate2" title="Not good">2 stars</label>
                     <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                     <label for="first-rate3" title="Average">3 stars</label>
                     <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                     <label for="first-rate4" title="Very good">4 stars</label>
                     <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                     <label for="first-rate5" title="Amazing">5 stars</label>
                  </fieldset>
               </div>
               <div class="mb-3">
                  <label for="body" class="form-label text-secondary small fw-bold">Review</label>
                  <textarea class="form-control" name="review[body]" id="body" rows="3" required></textarea>
                  <div class="valid-feedback">Looks good!</div>
               </div>
               <button class="btn btn-camp-primary">Submit Review</button>
            </form>
         </div>
      <% } else { %>
         <div class="card show-card mb-4 p-4 text-center bg-white">
            <p class="text-secondary mb-3">Have you visited <%= campground.title %>?</p>
            <div>
               <a href="/login" class="btn btn-sm btn-camp-primary">Log in to leave a review</a>
            </div>
         </div>
      <% } %>

      <!-- Reviews Section -->
      <h5 class="fw-bold text-dark mb-3">Reviews</h5>

      <% if(!campground.reviews.length) { %>
         <p class="text-muted small">No reviews yet.</p>
      <% } %>

      <% for(let review of campground.reviews) { %>
         <div class="card review-card mb-3">
            <div class="card-body p-3">
               <div class="d-flex align-items-center justify-content-between mb-2">
                  <h6 class="fw-bold mb-0 text-dark"><%= review.author.username %></h6>
                  <% if(currentUser && review.author.equals(currentUser._id)) { %>
                     <form action="/campgrounds/<%= campground._id %>/reviews/<%= review._id %>?_method=DELETE" method="post" class="mb-0">
                        <button class="btn btn-sm btn-outline-danger border-0 py-0 px-1" title="Delete">
                           &times;
                        </button>
                     </form>
                  <% } %>
               </div>

               <p class="starability-result mb-2" data-rating="<%= review.rating %>">
                  Rated: <%= review.rating %> stars
               </p>
               <p class="card-text text-secondary mb-0"><%= review.body %></p>
            </div>
         </div>
      <% } %>
   </div>
</div>

<script>
   const campground = <%- JSON.stringify(campground) %>;
</script>
<script src="/javascripts/map.js"></script>
