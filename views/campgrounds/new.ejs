<% layout('layouts/boilerplate') %>

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="form-card my-3">
            <div class="text-center mb-4 pb-2 border-bottom">
                <span class="badge bg-success-subtle text-success-emphasis rounded-pill px-3 py-1 mb-2">
                    <i class="bi bi-tree me-1"></i>Community Submission
                </span>
                <h1 class="h3 fw-bold text-dark mb-1">Add a New Campground</h1>
                <p class="text-secondary small mb-0">Share your favorite campsite, scenic hideout, or wilderness retreat with the community.</p>
            </div>

            <form action="/campgrounds" method="post" novalidate class="validated-form" enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="title" class="form-label">
                        <i class="bi bi-fonts text-success me-1"></i>Campground Title
                    </label>
                    <input type="text" class="form-control" id="title" name="campground[title]" placeholder="e.g. Whispering Pines Camp" required>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">Please provide a campground title.</div>
                </div>

                <div class="mb-3">
                    <label for="location" class="form-label">
                        <i class="bi bi-geo-alt-fill text-danger me-1"></i>Location
                    </label>
                    <input type="text" id="location" class="form-control" name="campground[location]" placeholder="e.g. Yosemite National Park, CA" required>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">Please enter a valid location.</div>
                </div>

                <div class="mb-3">
                    <label for="price" class="form-label">
                        <i class="bi bi-tag-fill text-primary me-1"></i>Nightly Price ($ USD)
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-secondary fw-bold" id="price-label">$</span>
                        <input type="text" class="form-control" id="price" placeholder="0.00" aria-label="Price" name="campground[price]" aria-describedby="price-label" required>
                        <div class="valid-feedback">Looks good!</div>
                        <div class="invalid-feedback">Please enter a price per night.</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">
                        <i class="bi bi-card-text text-info me-1"></i>Description
                    </label>
                    <textarea id="description" class="form-control" name="campground[description]" rows="4" placeholder="Describe the campsite amenities, scenery, accessibility, and wildlife..." required></textarea>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">Please write a short description.</div>
                </div>

                <div class="mb-4">
                    <label for="image" class="form-label">
                        <i class="bi bi-images text-warning me-1"></i>Upload Campground Photos
                    </label>
                    <input class="form-control" type="file" id="image" multiple name="image" accept="image/*">
                    <small class="text-muted d-block mt-1">You can select multiple photos (PNG, JPG, JPEG).</small>
                </div>

                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 pt-2 border-top">
                    <a href="/campgrounds" class="btn btn-camp-secondary d-inline-flex align-items-center">
                        <i class="bi bi-arrow-left me-1"></i>Cancel
                    </a>
                    <button class="btn btn-camp-primary d-inline-flex align-items-center shadow-sm">
                        <i class="bi bi-cloud-arrow-up me-2"></i>Publish Campground
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
