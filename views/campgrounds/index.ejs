

<% layout(`layouts/boilerplate`) %>

<!-- Header Section -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="h2 fw-bold text-dark mb-1">Explore Campgrounds</h1>
        <p class="text-secondary mb-0">Discover top-rated destinations, view on map, or share your own favorite retreat.</p>
    </div>
    <div>
        <a href="/campgrounds/new" class="btn btn-camp-primary d-inline-flex align-items-center shadow-sm">
            <i class="bi bi-plus-circle me-2"></i>Add Campground
        </a>
    </div>
</div>

<!-- Interactive Cluster Map -->
<div class="mb-5">
    <div class="d-flex align-items-center justify-content-between mb-2">
        <span class="text-muted small">
            <i class="bi bi-pin-map-fill text-success me-1"></i><strong>Campground Cluster Map</strong> &bull; Click clusters to zoom in
        </span>
        <span class="badge bg-success-subtle text-success-emphasis rounded-pill px-3 py-1">
            <%= campgrounds.length %> locations registered
        </span>
    </div>
    <div id="map" style="width: 100%; height: 380px;"></div>
</div>

<!-- Campgrounds List -->
<div class="row g-4">
    <% for(let campground of campgrounds){ %>
        <div class="col-12">
            <div class="card camp-card">
                <div class="row g-0 align-items-center">
                    <div class="col-md-4">
                        <div class="img-wrapper">
                            <% if(campground.images && campground.images.length) { %>
                                <img class="img-fluid" src="<%= campground.images[0].url %>" alt="<%= campground.title %>" loading="lazy">
                            <% } else { %>
                                <img class="img-fluid" src="https://res.cloudinary.com/dpmoflxc3/image/upload/v1722797295/YelpCamp/cvyvqyawlh1copeqrchw.jpg" alt="Campground placeholder" loading="lazy">
                            <% } %>
                            <% if(campground.price) { %>
                                <span class="price-tag">$<%= campground.price %><small>/night</small></span>
                            <% } %>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div class="card-body">
                            <h5 class="camp-title"><%= campground.title %></h5>
                            <div class="camp-location">
                                <i class="bi bi-geo-alt-fill text-danger"></i>
                                <span><%= campground.location %></span>
                            </div>
                            <p class="camp-desc"><%= campground.description %></p>
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 pt-2 border-top">
                                <span class="text-muted small">
                                    <i class="bi bi-tree text-success me-1"></i>Verified Camp Spot
                                </span>
                                <a href="/campgrounds/<%= campground._id %>" class="btn btn-sm btn-camp-primary d-inline-flex align-items-center">
                                    <span>Explore Details</span>
                                    <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    <% } %>
</div>

<script>
    const campgrounds = <%- JSON.stringify(campgrounds) %>;
</script>
<script src="/javascripts/clustermap.js"></script>