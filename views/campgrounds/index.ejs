<% layout(`layouts/boilerplate`) %>

<!-- Header -->
<div class="d-flex align-items-center justify-content-between mb-3 mb-md-4 flex-wrap gap-2">
    <h1 class="h2 fw-bold text-dark mb-0">All Campgrounds</h1>
    <a href="/campgrounds/new" class="btn btn-camp-primary">Add Campground</a>
</div>

<!-- Map -->
<div id="map" class="mb-4 mb-md-5"></div>

<!-- Campgrounds List -->
<div class="row g-3 g-md-4">
    <% for(let campground of campgrounds){ %>
        <div class="col-12">
            <div class="card camp-card">
                <div class="row g-0 align-items-center">
                    <div class="col-md-4">
                        <div class="img-wrapper">
                            <% if(campground.images && campground.images.length) { %>
                                <img class="img-fluid" src="<%= campground.images[0].url %>" alt="<%= campground.title %>" loading="lazy">
                            <% } else { %>
                                <img class="img-fluid" src="https://res.cloudinary.com/dpmoflxc3/image/upload/v1722797295/YelpCamp/cvyvqyawlh1copeqrchw.jpg" alt="Campground placeholder" loading="lazy">
                            <% } %>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div class="card-body">
                            <h5 class="camp-title"><%= campground.title %></h5>
                            <p class="camp-location mb-2"><%= campground.location %></p>
                            <p class="camp-desc"><%= campground.description %></p>
                            <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                                <span class="fw-bold text-dark">$<%= campground.price %><span class="text-muted fw-normal small">/night</span></span>
                                <a href="/campgrounds/<%= campground._id %>" class="btn btn-sm btn-camp-primary">View</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    <% } %>
</div>

<script>
    const campgrounds = <%- JSON.stringify(campgrounds) %>;
</script>
<script src="/javascripts/clustermap.js"></script>
