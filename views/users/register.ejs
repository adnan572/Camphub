<% layout("layouts/boilerplate") %>

<div class="row justify-content-center my-5">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div style="height: 140px; overflow: hidden; position: relative;">
                <img src="https://images.unsplash.com/photo-1510312305653-8ed496efae75?q=80&w=1522&auto=format&fit=crop" class="w-100 h-100 object-fit-cover" alt="Camping tent">
                <div style="position: absolute; inset: 0; background: rgba(15,23,42,0.45);"></div>
                <div style="position: absolute; bottom: 16px; left: 24px;">
                    <h2 class="h4 fw-bold text-white mb-0">Register</h2>
                </div>
            </div>

            <div class="card-body p-4 bg-white">
                <form action="/register" method="post" class="validated-form" novalidate>
                    <div class="mb-3">
                        <label for="username" class="form-label">Username</label>
                        <input type="text" id="username" class="form-control" name="username" required autofocus>
                        <div class="valid-feedback">Looks good!</div>
                    </div>
                
                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" id="email" class="form-control" name="email" required>
                        <div class="valid-feedback">Looks good!</div>
                    </div>
                
                    <div class="mb-4">
                        <label for="password" class="form-label">Password</label>
                        <input type="password" id="password" class="form-control" name="password" required>
                        <div class="valid-feedback">Looks good!</div>
                    </div>

                    <button type="submit" class="btn btn-camp-primary w-100 py-2">Create Account</button>
                </form>

                <div class="text-center mt-4 pt-3 border-top">
                    <p class="text-secondary small mb-0">
                        Already have an account? 
                        <a href="/login" class="text-dark fw-bold text-decoration-none">Log in</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
